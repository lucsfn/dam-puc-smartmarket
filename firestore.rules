  rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      // Cada usuário acessa somente seus próprios dados
      match /users/{uid}/listas/{listaId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.nome is string
          && request.resource.data.nome.size() > 0;

        match /produtos/{produtoId} {
          allow read, delete: if request.auth != null && request.auth.uid == uid;
          allow create, update: if request.auth != null && request.auth.uid == uid
            && request.resource.data.nomeProduto is string
            && request.resource.data.nomeProduto.size() > 0
            && request.resource.data.quantidade is number
            && request.resource.data.quantidade > 0
            && request.resource.data.precoUnitario is number
            && request.resource.data.precoUnitario >= 0;
        }
      }
    }
  }
